# HARVEX backend environment configuration
# Copy this file to .env and fill in real values (never commit .env).

# Optional. If set, agent explanation text is generated by a live call to
# the Anthropic Messages API. If unset (or the call fails for any reason),
# HARVEX automatically falls back to deterministic "Simulation mode"
# explanations built from real computed numbers, so the product always
# stays demoable offline.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional. Flask port, defaults to 5000.
PORT=5000

# Optional. Set to 1 for Flask debug/auto-reload during development.
FLASK_DEBUG=0
